# Safe local defaults. Do not put real secrets in this file.

APP_NAME=infra-config-portal
ENVIRONMENT=local
PROVIDER_MODE=local-lab-readwrite
DATABASE_URL=sqlite:///./.local/infra_config_portal.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Saved lab profiles are local-only under repo-root .local/lab-profiles.json
# and drive app defaults. Do not commit saved profiles. Optional provider
# runtime variables belong in repo-root .env.local.real-lab, not in committed
# env files. That file is bootstrap/secrets/emergency override only; reports
# and artifacts are evidence, not a configuration source.
# Generate .env.local.real-lab with ./scripts/setup-real-lab-env.sh from the
# repo root. Mock mode is reserved for automated tests; the running app should
# show real-lab, not-checked, stale evidence, or live status.
#
# /24 high-address lab profile example:
# LAB_PROFILE_TOPOLOGY=high_address_lab
# LAB_SUBNET_CIDR=192.168.1.0/24
# ILO_TEST_HOST=192.168.1.201
# SERVER_EMBEDDED_NIC_IP=192.168.1.202
# ESXI_TEST_HOST=192.168.1.203
# CISCO_TARGET_IP=192.168.1.204
# ANSIBLE_CISCO_HOST=192.168.1.204
# ANSIBLE_CONTROL_HOST=192.168.1.205
# NETAPP_CONTROLLER_A_SP=192.168.1.210
# NETAPP_CONTROLLER_B_SP=192.168.1.211
# NETAPP_CLUSTER_MGMT_IP=192.168.1.220
# NETAPP_NODE_A_MGMT_IP=192.168.1.221
# NETAPP_NODE_B_MGMT_IP=192.168.1.222
# NETAPP_SVM_MGMT_IP=192.168.1.223
# NETAPP_NFS_LIFS=192.168.1.230,192.168.1.231
# NETAPP_ISCSI_LIFS=192.168.1.240,192.168.1.241,192.168.1.242,192.168.1.243
#
# /26 compact lab profile example:
# LAB_PROFILE_TOPOLOGY=compact_edge_lab
# LAB_SUBNET_CIDR=10.10.5.0/26
# LAB_GATEWAY=10.10.5.1
# CISCO_TARGET_IP=10.10.5.2
# ANSIBLE_CISCO_HOST=10.10.5.2
# ANSIBLE_CONTROL_HOST=10.10.5.9
# ESXI_TEST_HOST=10.10.5.10
# ILO_TEST_HOST=10.10.5.11
# NETAPP_CONFIGURED=false
# VCENTER_CONFIGURED=false
# NETAPP_STORAGE_PROTOCOL=none
# ANSIBLE_CISCO_HOST is the Cisco device inventory target, not the control host.
# Cisco first contact/bootstrap is still console. Ansible starts after Cisco
# management SSH is configured and is for show commands, backup, validation,
# drift checks, and future repeatable config.
# local-lab-readwrite mode is separate from test-only mock and local-readonly. It requires these
# private .env.local.real-lab flags before contacting real lab hardware:
# LAB_ENVIRONMENT=isolated-real-lab
# LAB_ACKNOWLEDGE_REAL_HARDWARE=true
# LAB_ACKNOWLEDGE_DEVICE_RECONFIGURATION=true
# LAB_ACKNOWLEDGE_DATA_LOSS_RISK=true
# LAB_ACKNOWLEDGE_LAB_ONLY=true
# High-risk local-lab-readwrite actions default to false unless explicitly enabled:
# LAB_ALLOW_POWER_ACTIONS=false
# LAB_ALLOW_FIRMWARE_UPDATES=false
# LAB_ALLOW_FACTORY_RESET=false
# ILO_TEST_HOST=
# ILO_TEST_USERNAME=
# ILO_TEST_PASSWORD=
# ILO_TEST_VERIFY_TLS=true
# Guarded real-lab iLO HostName setup apply is blocked unless all gates are
# set explicitly outside normal mock tests. It does not allow IP, gateway,
# VLAN, user, SNMP, NTP, DNS, firmware, virtual media, boot, power, or reset.
# ILO_SETUP_APPLY_ENABLED=false
# ESXI_CONFIGURED=false
# Set ESXI_CONFIGURED=true only after the ESXi management network is installed
# and ready for read-only HTTPS/SSH probes. ESXI_TEST_HOST may be a planned IP
# while ESXI_CONFIGURED=false.
# ESXI_TEST_HOST=
# ESXI_TEST_USERNAME=
# ESXI_TEST_PASSWORD=
# ESXI_TEST_VERIFY_TLS=true
# CISCO_MGMT_CONFIGURED=false
# Set CISCO_MGMT_CONFIGURED=true only after console bootstrap has configured
# Cisco management IP/SSH. Console discovery remains active while this is false.
# CISCO_TARGET_IP=
# CISCO_TEST_USERNAME=
# CISCO_TEST_PASSWORD=
# ANSIBLE_CISCO_HOST=
# ANSIBLE_CONTROL_HOST=
# CISCO_CONSOLE_PORT=
# CISCO_CONSOLE_BAUD=9600
# Prompt readiness still sends newline only; these only tune the bounded read.
# CISCO_CONSOLE_PROMPT_SETTLE_SECONDS=0.5
# CISCO_CONSOLE_PROMPT_READ_WINDOW_SECONDS=1.0
# CISCO_CONSOLE_PROMPT_MAX_BYTES=8192
# Guarded real-lab console bootstrap apply is blocked unless all are set
# explicitly outside normal mock tests.
# CISCO_CONSOLE_APPLY_ENABLED=false
# NETAPP_CONFIGURED is legacy/advanced override context only. NetApp configured
# state is derived from live validation and persisted in local app state.
# NETAPP_CONTROLLER_A_SP=
# NETAPP_CONTROLLER_B_SP=
# NETAPP_CLUSTER_MGMT_IP=
# NETAPP_NODE_A_MGMT_IP=
# NETAPP_NODE_B_MGMT_IP=
# NETAPP_SVM_MGMT_IP=
# NETAPP_ISCSI_LIFS=
# NETAPP_API_USERNAME=
# NETAPP_API_PASSWORD=
# NETAPP_API_VERIFY_TLS=true
# Optional hint only. Console autodiscovery still runs unless explicitly disabled.
# NETAPP_CONSOLE_PORT=
# NETAPP_CONSOLE_BAUD=115200
# NETAPP_CONSOLE_AUTODISCOVERY_DISABLED=false
# NETAPP_CONSOLE_TIMEOUT_SECONDS=2.0
# NETAPP_CONNECTED_MANAGEMENT_PORTS=cluster_mgmt
# NETAPP_MANAGEMENT_TOPOLOGY_NOTE=Only one NetApp management port is connected at the moment.
# NETAPP_STORAGE_PROTOCOL=nfs
# NETAPP_NFS_LIFS=192.168.1.230,192.168.1.231
# NETAPP_NFS_VOLUME=esxi_datastore_01
# NETAPP_NFS_EXPORT_POLICY=esxi_nfs_policy
# NETAPP_NFS_MOUNT_PATH=/esxi_datastore_01
# NETAPP_NFS_DATASTORE_NAME=netapp_nfs_ds01
# NETAPP_NFS_CLIENT_MATCH=192.168.1.0/24
# VCENTER_CONFIGURED=false
# VCENTER_HOST=
# VCENTER_USERNAME=
# VCENTER_PASSWORD=
# VCENTER_VERIFY_TLS=false
# vCenter install intent is local-only. Keep secret values in .env.local.real-lab
# or the operator environment; reports show configured/missing only.
# VCENTER_APPLIANCE_NAME=
# VCENTER_MANAGEMENT_IP=
# VCENTER_SUBNET_CIDR=192.168.1.0/24
# VCENTER_GATEWAY=192.168.1.1
# VCENTER_DNS_SERVERS=
# VCENTER_NTP_SERVERS=
# VCENTER_SSO_DOMAIN=vsphere.local
# VCENTER_SSO_ADMIN_USERNAME=administrator@vsphere.local
# VCENTER_SSO_ADMIN_PASSWORD=
# VCENTER_APPLIANCE_ROOT_PASSWORD=
# VCENTER_ESXI_TARGET=192.168.1.203
# VCENTER_DATASTORE_TARGET=netapp_nfs_ds01
# VCENTER_DATACENTER_NAME=Lab-DC
# VCENTER_CLUSTER_NAME=Lab-Cluster
# VCENTER_VCSA_ISO_PATH=
# VCENTER_DEPLOYMENT_SIZE=tiny
# VCENTER_NETWORK=
# VCENTER_PORTGROUP=
# LAB_APPLY_ACK=
# LAB_TARGET_ACK=
# LAB_DESTRUCTIVE_ACK=
#
# Optional in-app AI interpreter for Tier 1 layout requests. Keep the real key
# in .env.local.real-lab or the operator environment only; never commit it.
# ANTHROPIC_API_KEY=
# ANTHROPIC_UI_INTENT_MODEL=claude-opus-4-8

# Docker Compose PostgreSQL defaults. These are local development values only.
POSTGRES_DB=infra_config_portal
POSTGRES_USER=infra_config_portal
POSTGRES_PASSWORD=infra_config_portal_local_only
