# Safe local defaults. Do not put real secrets in this file.

APP_NAME=infra-config-portal
ENVIRONMENT=local
PROVIDER_MODE=mock
DATABASE_URL=sqlite:///./.local/infra_config_portal.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional provider preview variables belong in repo-root .env.local.real-lab,
# not in committed env files. Keep PROVIDER_MODE=mock unless manually running
# explicit local-readonly iLO/Cisco/ESXi probes on an isolated lab machine.
# Generate that file with ./scripts/setup-real-lab-env.sh from the repo root.
# ILO_TEST_HOST=
# ILO_TEST_USERNAME=
# ILO_TEST_PASSWORD=
# ILO_TEST_VERIFY_TLS=true
# ESXI_CONFIGURED=false
# Set ESXI_CONFIGURED=true only after the ESXi management network is installed
# and ready for read-only HTTPS/SSH probes. ESXI_TEST_HOST may be a planned IP
# while ESXI_CONFIGURED=false.
# ESXI_TEST_HOST=
# ESXI_TEST_USERNAME=
# ESXI_TEST_PASSWORD=
# ESXI_TEST_VERIFY_TLS=true
# CISCO_MGMT_CONFIGURED=false
# Set CISCO_MGMT_CONFIGURED=true only after console bootstrap has configured
# Cisco management IP/SSH. Console discovery remains active while this is false.
# CISCO_TARGET_IP=
# CISCO_TEST_USERNAME=
# CISCO_TEST_PASSWORD=
# CISCO_CONSOLE_PORT=
# CISCO_CONSOLE_BAUD=9600
# Guarded real-lab console bootstrap apply is blocked unless all are set
# explicitly outside normal mock tests.
# CISCO_CONSOLE_APPLY_ENABLED=false
# LAB_APPLY_ACK=
# LAB_TARGET_ACK=
# LAB_DESTRUCTIVE_ACK=

# Docker Compose PostgreSQL defaults. These are local development values only.
POSTGRES_DB=infra_config_portal
POSTGRES_USER=infra_config_portal
POSTGRES_PASSWORD=infra_config_portal_local_only
