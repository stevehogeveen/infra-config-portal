# Safe local defaults. Do not put real secrets in this file.

APP_NAME=infra-config-portal
ENVIRONMENT=local
PROVIDER_MODE=mock
DATABASE_URL=sqlite:///./.local/infra_config_portal.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Docker Compose PostgreSQL defaults. These are local development values only.
POSTGRES_DB=infra_config_portal
POSTGRES_USER=infra_config_portal
POSTGRES_PASSWORD=infra_config_portal_local_only
