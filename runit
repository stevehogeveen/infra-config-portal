#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
APP_DIR="${ROOT_DIR}/app"
BACKEND_DIR="${APP_DIR}/backend"
FRONTEND_DIR="${APP_DIR}/frontend"
RUN_DIR="${ROOT_DIR}/.local/run"
LOG_DIR="${ROOT_DIR}/.local/log"
BACKEND_PORT="${BACKEND_PORT:-8001}"
FRONTEND_PORT="${FRONTEND_PORT:-5173}"
BACKEND_HOST="${BACKEND_HOST:-127.0.0.1}"
FRONTEND_HOST="${FRONTEND_HOST:-127.0.0.1}"
PUBLIC_APP_HOST="${PUBLIC_APP_HOST:-}"
APP_PROXY_TARGET="${APP_PROXY_TARGET:-http://127.0.0.1:${BACKEND_PORT}}"
FRONTEND_API_BASE_URL="${FRONTEND_API_BASE_URL:-}"
BACKEND_PID_FILE="${RUN_DIR}/infra-config-portal-backend.pid"
FRONTEND_PID_FILE="${RUN_DIR}/infra-config-portal-frontend.pid"
APP_MODE_ENV_FILE="${APP_MODE_ENV_FILE:-${ROOT_DIR}/.local/app-mode.env}"

usage() {
  cat <<EOF
Usage: ./runit [start|stop|restart|status|check]

Safe local app workflow:
  ./runit start    Start backend and frontend dev servers.
  ./runit stop     Stop only app-owned backend/frontend processes from PID files.
  ./runit restart  Stop then start the app without touching browser processes.
  ./runit status   Show app process status.
  ./runit check    Alias for status.

Ports:
  Backend:  ${BACKEND_PORT}
  Frontend: ${FRONTEND_PORT}

Bind hosts:
  Backend:  ${BACKEND_HOST}
  Frontend: ${FRONTEND_HOST}

LAN access:
  FRONTEND_HOST=0.0.0.0 ./runit restart
  PUBLIC_APP_HOST=<this-host-lan-ip> FRONTEND_HOST=0.0.0.0 ./runit restart
EOF
}

die() {
  echo "Error: $*" >&2
  exit 1
}

log() {
  echo "$*"
}

default_public_host() {
  if command -v ip >/dev/null 2>&1; then
    ip -4 -o addr show scope global 2>/dev/null \
      | awk '{ split($4, addr, "/"); print addr[1]; exit }'
    return 0
  fi
  hostname -I 2>/dev/null | awk '{ print $1; exit }'
}

display_host_for_bind() {
  local bind_host="$1"
  if [[ -n "${PUBLIC_APP_HOST}" ]]; then
    printf '%s\n' "${PUBLIC_APP_HOST}"
    return 0
  fi
  case "${bind_host}" in
    0.0.0.0|::)
      default_public_host
      ;;
    *)
      printf '%s\n' "${bind_host}"
      ;;
  esac
}

load_provider_mode_config() {
  if [[ -n "${PROVIDER_MODE:-}" ]]; then
    return 0
  fi
  [[ -f "${APP_MODE_ENV_FILE}" ]] || return 0

  local mode
  mode="$(
    awk -F= '$1 == "PROVIDER_MODE" {print $2; exit}' "${APP_MODE_ENV_FILE}" 2>/dev/null \
      | tr -d '[:space:]'
  )"
  case "${mode}" in
    mock|local-readonly|local-lab-readwrite)
      export PROVIDER_MODE="${mode}"
      ;;
    "")
      ;;
    *)
      log "Ignoring unsupported PROVIDER_MODE in ${APP_MODE_ENV_FILE}: ${mode}"
      ;;
  esac
  if [[ -z "${PROVIDER_MODE:-}" ]]; then
    export PROVIDER_MODE="local-lab-readwrite"
  fi
}

ensure_repo_root() {
  cd "${ROOT_DIR}"
  [[ -x "${ROOT_DIR}/scripts/check-repo-root.sh" ]] || die "scripts/check-repo-root.sh not found or not executable."
  "${ROOT_DIR}/scripts/check-repo-root.sh"
}

pid_cmdline() {
  local pid="$1"
  tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true
}

pid_cwd() {
  local pid="$1"
  readlink -f "/proc/${pid}/cwd" 2>/dev/null || true
}

pid_exists() {
  local pid="$1"
  [[ "${pid}" =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null
}

is_backend_pid() {
  local pid="$1"
  local cmd cwd
  pid_exists "${pid}" || return 1
  cmd="$(pid_cmdline "${pid}")"
  cwd="$(pid_cwd "${pid}")"
  [[ "${cwd}" == "${BACKEND_DIR}" ]] || return 1
  [[ "${cmd}" == *"uvicorn"* && "${cmd}" == *"app.main:app"* ]] || return 1
}

is_frontend_pid() {
  local pid="$1"
  local cmd cwd
  pid_exists "${pid}" || return 1
  cmd="$(pid_cmdline "${pid}")"
  cwd="$(pid_cwd "${pid}")"
  [[ "${cwd}" == "${FRONTEND_DIR}" ]] || return 1
  [[ "${cmd}" == *"npm run dev"* || "${cmd}" == *"vite"* ]] || return 1
}

read_pid_file() {
  local pid_file="$1"
  [[ -f "${pid_file}" ]] || return 1
  local pid
  pid="$(<"${pid_file}")"
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "${pid}"
}

process_label() {
  local service="$1"
  local pid="$2"
  local cmd
  cmd="$(pid_cmdline "${pid}")"
  printf '%s PID %s (%s)' "${service}" "${pid}" "${cmd:-unknown command}"
}

stop_pid_file() {
  local service="$1"
  local pid_file="$2"
  local validator="$3"
  local pid

  if ! pid="$(read_pid_file "${pid_file}")"; then
    stop_discovered_service "${service}" "${validator}"
    return 0
  fi

  if ! pid_exists "${pid}"; then
    log "${service}: removing stale PID file for PID ${pid}."
    rm -f "${pid_file}"
    return 0
  fi

  if ! "${validator}" "${pid}"; then
    log "${service}: PID file points at PID ${pid}, but it is not this app's ${service} process."
    log "${service}: leaving it running and removing stale/unsafe PID file."
    rm -f "${pid_file}"
    return 0
  fi

  log "Stopping $(process_label "${service}" "${pid}") because ${pid_file} records it as app-owned."
  kill -TERM -- "-${pid}" 2>/dev/null || kill -TERM "${pid}" 2>/dev/null || true

  for _ in 1 2 3 4 5; do
    if ! pid_exists "${pid}"; then
      rm -f "${pid_file}"
      log "${service}: stopped."
      return 0
    fi
    sleep 1
  done

  log "${service}: still running after TERM; force stopping app-owned process group ${pid}."
  kill -KILL -- "-${pid}" 2>/dev/null || kill -KILL "${pid}" 2>/dev/null || true
  rm -f "${pid_file}"
}

stop_discovered_service() {
  local service="$1"
  local validator="$2"
  local found=0
  local proc pid

  for proc in /proc/[0-9]*; do
    pid="${proc##*/}"
    if "${validator}" "${pid}"; then
      found=1
      log "Stopping discovered $(process_label "${service}" "${pid}") because it matches this repo's ${service} command and cwd."
      kill -TERM -- "-${pid}" 2>/dev/null || kill -TERM "${pid}" 2>/dev/null || true
    fi
  done

  if [[ "${found}" -eq 0 ]]; then
    log "${service}: no PID file and no matching app-owned process found; nothing to stop."
  fi
}

service_status() {
  local service="$1"
  local pid_file="$2"
  local validator="$3"
  local pid

  if ! pid="$(read_pid_file "${pid_file}")"; then
    log "${service}: stopped (no PID file)."
    return 1
  fi

  if "${validator}" "${pid}"; then
    log "${service}: running as $(process_label "${service}" "${pid}")"
    return 0
  fi

  if pid_exists "${pid}"; then
    log "${service}: PID file points at non-app PID ${pid}; refusing to manage it."
  else
    log "${service}: stopped (stale PID file for PID ${pid})."
  fi
  return 1
}

start_service() {
  local service="$1"
  local pid_file="$2"
  local validator="$3"
  local workdir="$4"
  local log_file="$5"
  shift 5

  local pid
  if pid="$(read_pid_file "${pid_file}")" && "${validator}" "${pid}"; then
    log "${service}: already running as $(process_label "${service}" "${pid}")"
    return 0
  fi

  if [[ -n "${pid:-}" && -f "${pid_file}" ]]; then
    log "${service}: removing stale PID file ${pid_file}."
    rm -f "${pid_file}"
  fi

  log "Starting ${service} in ${workdir}; logs: ${log_file}"
  if command -v setsid >/dev/null 2>&1; then
    (
      cd "${workdir}"
      setsid "$@" > "${log_file}" 2>&1 &
      echo $! > "${pid_file}"
    )
  else
    (
      cd "${workdir}"
      "$@" > "${log_file}" 2>&1 &
      echo $! > "${pid_file}"
    )
  fi

  pid="$(<"${pid_file}")"
  sleep 1
  if ! "${validator}" "${pid}"; then
    log "${service}: failed to start or did not match the expected app command."
    log "${service}: recent log output:"
    tail -n 40 "${log_file}" 2>/dev/null || true
    rm -f "${pid_file}"
    return 1
  fi

  log "${service}: started as $(process_label "${service}" "${pid}")"
}

run_smoke() {
  log
  log "Running mock smoke test before start..."
  make smoke
}

start_app() {
  ensure_repo_root
  load_provider_mode_config
  mkdir -p "${RUN_DIR}" "${LOG_DIR}"
  run_smoke
  log "Starting backend with PROVIDER_MODE=${PROVIDER_MODE:-local-lab-readwrite}"
  start_service "backend" "${BACKEND_PID_FILE}" is_backend_pid "${BACKEND_DIR}" "${LOG_DIR}/backend.log" \
    "${BACKEND_DIR}/.venv/bin/uvicorn" app.main:app --reload --host "${BACKEND_HOST}" --port "${BACKEND_PORT}"
  start_service "frontend" "${FRONTEND_PID_FILE}" is_frontend_pid "${FRONTEND_DIR}" "${LOG_DIR}/frontend.log" \
    env "VITE_API_BASE_URL=${FRONTEND_API_BASE_URL}" "APP_PROXY_TARGET=${APP_PROXY_TARGET}" \
      npm run dev -- --host "${FRONTEND_HOST}" --port "${FRONTEND_PORT}"

  local frontend_open_host backend_open_host
  frontend_open_host="$(display_host_for_bind "${FRONTEND_HOST}")"
  backend_open_host="$(display_host_for_bind "${BACKEND_HOST}")"

  log
  log "Open:"
  log "  Frontend: http://${frontend_open_host}:${FRONTEND_PORT}"
  log "  Backend:  http://${backend_open_host}:${BACKEND_PORT}"
  log "  API docs: http://${backend_open_host}:${BACKEND_PORT}/docs"
  log "  Frontend proxy target: ${APP_PROXY_TARGET}"
}

stop_app() {
  ensure_repo_root
  mkdir -p "${RUN_DIR}"
  stop_pid_file "frontend" "${FRONTEND_PID_FILE}" is_frontend_pid
  stop_pid_file "backend" "${BACKEND_PID_FILE}" is_backend_pid
}

status_app() {
  ensure_repo_root
  load_provider_mode_config
  log "configured provider mode: ${PROVIDER_MODE:-local-lab-readwrite}"
  service_status "backend" "${BACKEND_PID_FILE}" is_backend_pid || true
  service_status "frontend" "${FRONTEND_PID_FILE}" is_frontend_pid || true
}

command="${1:-restart}"

case "${command}" in
  start)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    log "== Infra Config Portal: safe start =="
    start_app
    ;;
  stop)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    log "== Infra Config Portal: safe stop =="
    stop_app
    ;;
  restart)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    log "== Infra Config Portal: safe restart =="
    stop_app
    start_app
    ;;
  status|check)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    log "== Infra Config Portal: status =="
    status_app
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
