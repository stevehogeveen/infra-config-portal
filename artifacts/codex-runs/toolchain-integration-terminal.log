                ],
            )

        safety = current_lab_safety()
        policy = current_lab_action_policy(self.provider_mode)
        readonly_allowed = (
            safety.readonly_allowed if self.provider_mode == "local-readonly" else policy.readonly_allowed
        )
        if not readonly_allowed:
