+def _optional_python_family_tool(name: str, modules: tuple[str, ...], purpose: str) -> dict[str, Any]:
+    checks = [
+        {
+            "module": module,
+            "available": importlib_util.find_spec(module) is not None,
+            "version": _python_module_version(module),
+        }
