+        lines.append(f"- {line}")
+    lines.extend(["", "### NetApp"])
+    for line in payload["managed_state"]["netapp"]["sequence"]:
+        lines.append(f"- {line}")
+    firmware = payload.get("firmware_strategy") or {}
+    lines.extend(
