+                stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT,
+                text=True,
+                timeout=5.0,
+                check=False,
+            )
+            available = result.returncode == 0 and collection in (result.stdout or "")
+            for line in (result.stdout or "").splitlines():
