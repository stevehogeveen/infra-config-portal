+def _cli_version(command: str) -> str | None:
+    version_args = {
+        "ansible": ["ansible", "--version"],
+        "govc": ["govc", "version"],
+        "ilorest": ["ilorest", "--version"],
+    }.get(command, [command, "--version"])
+    try:
+        result = subprocess.run(
+            version_args,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            text=True,
+            timeout=3.0,
