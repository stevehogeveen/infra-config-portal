+def _python_tool(name: str, module: str, purpose: str, *, required: bool) -> dict[str, Any]:
+    spec = importlib_util.find_spec(module)
+    return {
+        "name": name,
+        "type": "python-package",
+        "module": module,
+        "available": spec is not None,
+        "required": required,
+        "version": _python_module_version(module) if spec else None,
+        "purpose": purpose,
