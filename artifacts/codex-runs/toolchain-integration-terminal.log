+            "",
+            f"- Baseline source: `{firmware.get('baseline_source')}`",
+            f"- Rule: {firmware.get('rule')}",
+        ]
+    )
+    for source in firmware.get("inventory_sources") or []:
+        lines.append(f"- Inventory source: {source}")
