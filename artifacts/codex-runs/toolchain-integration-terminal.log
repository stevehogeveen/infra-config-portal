+def _normalize_console_transport(value: str | None) -> str:
+    normalized = (value or "local_serial").strip().lower().replace("-", "_")
+    if normalized in {"tcp", "tcp_console", "ser2net"}:
+        return "tcp_console"
+    return "local_serial"
+
