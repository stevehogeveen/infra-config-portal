                  asString(failure.next_action) || ""
                ].filter(Boolean)}
              />
            );
          })}
          <SetupPreviewBlock
            title="Credential compatibility"
            tag={labelize(asString(objectValue(verification?.credentials).classification) || "unknown")}
            lines={credentialChecks.slice(0, 5).map((item) => {

