+            f"required=`{tool.get('required')}` check=`{tool.get('check')}`"
+            + (f" version=`{version}`" if version else "")
+        )
+        lines.append(f"  - Purpose: {tool.get('purpose')}")
+    lines.extend(
+        [
+            "",
+            "## Managed-State Plan",
+            "",
