+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            text=True,
+            timeout=3.0,
+            check=False,
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+    first_line = (result.stdout or "").splitlines()[0:1]
+    return first_line[0].strip() if first_line else None
+
