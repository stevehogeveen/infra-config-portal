+        "cisco": "CISCO_TEST_PASSWORD",
+        "cisco_enable": "CISCO_ENABLE_PASSWORD or ANSIBLE_CISCO_ENABLE_PASSWORD",
+        "esxi": "ESXI_TEST_PASSWORD",
+        "netapp": "NETAPP_API_PASSWORD",
+    }.get(name, f"{name.upper()}_PASSWORD")
+
