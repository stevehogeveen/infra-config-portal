+            configured=configured,
+            reachable=None,
+            classification="operator_action_required",
+            next_action="Place the ESXi ISO under MEDIA_INVENTORY_DIRS or set ESXI_INSTALL_ISO/ESXI_ISO_PATH before ESXi boot verification.",
