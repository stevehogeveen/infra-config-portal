+        "ui_message": f"{item.get('protocol')} is {item.get('classification', 'unknown')}.",
+        "detail": "; ".join(item.get("blockers") or []) or item.get("next_action", "No blocker detail."),
+        "next_action": item.get("next_action", "Review protocol readiness."),
+    }
