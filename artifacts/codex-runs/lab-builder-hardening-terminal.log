+            continue
+        try:
+            iso_count += sum(1 for item in path.rglob("*.iso") if item.is_file())
+        except OSError:
+            continue
+    configured = bool(settings.media_inventory_dirs)
+    if not configured or iso_count == 0:
+        return protocol_readiness(
