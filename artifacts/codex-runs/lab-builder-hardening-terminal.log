+def _worst_classification(values: Any) -> str:
+    items = list(values)
+    if not items:
+        return "passed"
+    return min(items, key=lambda value: CLASSIFICATION_ORDER.get(value, 99))
+
+
+def _credential_field_name(name: str) -> str:
