+function BuildStageCard({ stage }: { stage: BuildStage }) {
+  return (
+    <article className="build-stage-card" id={`stage-${stage.id}`}>
+      <div className="build-stage-head">
+        <div>
+          <p className="summary-kicker">{stage.step}</p>
+          <h2>{stage.title}</h2>
+        </div>
+        <StatusPill status={stage.status} />
