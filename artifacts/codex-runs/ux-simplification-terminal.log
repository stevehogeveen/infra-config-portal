+        <NextActionPanel title="Last milestone" value={overview.lastMilestone} />
+        <NextActionPanel title="Operating mode" value={overview.mode} />
+      </div>
+    </section>
+  );
+}
+
+function NextActionPanel({
+  muted = false,
+  title,
+  value
+}: {
+  muted?: boolean;
+  title: string;
+  value: string;
+}) {
