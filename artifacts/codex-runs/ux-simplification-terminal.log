+    <div className={muted ? "next-action-panel muted-panel" : "next-action-panel"}>
+      <span>{title}</span>
+      <strong>{value}</strong>
+    </div>
+  );
+}
+
+function GuidedWorkflowLane({ stages }: { stages: BuildStage[] }) {
+  return (
+    <nav className="guided-workflow-lane" aria-label="Guided build workflow">
