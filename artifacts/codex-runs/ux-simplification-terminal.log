const { chromium } = require(\"playwright\");
const path = require(\"path\");
(async () => {
  const base = \"http://127.0.0.1:5173/providers\";
  const out = path.resolve(\"../../artifacts/screenshots\");
  const browser = await chromium.launch({ headless: true });
  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, deviceScaleFactor: 1 });
  async function open() {
    await page.goto(base, { waitUntil: \"domcontentloaded\", timeout: 30000 });
    await page.getByRole(\"heading\", { name: \"Lab Builder\" }).waitFor({ timeout: 30000 });
    await page.waitForTimeout(1200);
  }
  async function snap(name, selector) {
    await open();
    if (selector) {
      await page.locator(selector).scrollIntoViewIfNeeded();
      await page.waitForTimeout(300);
    }
    await page.screenshot({ path: path.join(out, name), fullPage: false });
  }
  await snap(\"ux-after-overview.png\");
  await snap(\"ux-after-cisco.png\", \"#stage-cisco\");
  await snap(\"ux-after-hpe.png\", \"#stage-hpe-server\");
  await snap(\"ux-after-esxi.png\", \"#stage-esxi\");
  await snap(\"ux-after-verification.png\", \"#stage-verification\");
  await browser.close();
})();
