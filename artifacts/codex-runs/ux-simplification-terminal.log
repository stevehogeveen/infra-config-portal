+    </article>
+  );
+}
+
+function StatusPill({ status }: { status: string }) {
+  return <span className={`status-pillow ${statusTone(status)}`}>{displayStatusLabel(status)}</span>;
+}
+
+function buildLabOverview(
+  stages: BuildStage[],
+  verification: ProviderProbeResult | null,
