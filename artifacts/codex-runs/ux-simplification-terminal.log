exec
/bin/bash -lc "cd app/frontend && node -e '
const { chromium } = require(\"playwright\");
const path = require(\"path\");
(async () => {
  const base = \"http://127.0.0.1:5173/providers\";
  const out = path.resolve(\"../../artifacts/screenshots\");
  const browser = await chromium.launch({ headless: true });
  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, deviceScaleFactor: 1 });
  async function snap(name, url, action) {
    await page.goto(url, { waitUntil: \"networkidle\", timeout: 30000 });
    await page.waitForTimeout(800);
    if (action) await action();
    await page.screenshot({ path: path.join(out, name), fullPage: true });
  }
  await snap(\"ux-baseline-provider-status.png\", base);
  await snap(\"ux-baseline-cisco.png\", base + \"?section=cisco\");
  await snap(\"ux-baseline-hpe-ilo.png\", base + \"?section=ilo\");
  await snap(\"ux-baseline-raid.png\", base + \"?section=ilo\", async () => {
    const item = page.getByText(\"HPE Storage / RAID\", { exact: true }).first();
    if (await item.count()) await item.click();
    await page.waitForTimeout(300);
