              />
            ))}
          </div>
        </>
      )}
      <div className="form-actions provider-inline-actions">
        <button disabled={busy} onClick={onRefresh} type="button">
          <RefreshCw size={16} />
          {busy ? "Checking" : "Refresh ESXi Readiness"}
