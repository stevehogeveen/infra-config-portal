+                "Use console bootstrap to establish management VLAN/IP/SSH/SCP readiness."
+                if not mgmt_configured
+                else "Run explicit read-only SSH/Ansible probe before any configuration workflow."
+            ),
+        },
         "bootstrap_preview": {
             "apply_enabled": False,
             "commands_redacted": True,
