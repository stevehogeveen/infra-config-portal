+	$(MAKE) -C $(REPO_ROOT)/app provider-lab-cisco-console-ethernet-readiness
+
 netapp-real-readiness: check-repo-root
 	$(MAKE) -C $(REPO_ROOT)/app netapp-real-readiness PROVIDER_MODE="$(PROVIDER_MODE)"
