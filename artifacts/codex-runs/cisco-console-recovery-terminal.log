     return b"".join(chunks).decode("utf-8", errors="replace")
 
 
+def _toggle_dtr_rts(conn: Any) -> None:
+    for attr in ("dtr", "rts"):
+        if not hasattr(conn, attr):
+            continue
+        try:
+            setattr(conn, attr, False)
+            time.sleep(0.05)
+            setattr(conn, attr, True)
+        except Exception:
+            continue
