def _current_version_for(component_id: str, inventory: dict[str, Any]) -> str | None:
    live = inventory.get("live_inventory", {})
    ilo = live.get("ilo", {})
    cisco = live.get("cisco", {})
    netapp = live.get("netapp", {})
    mapping = {
        "hpe_ilo_firmware": ilo.get("ilo_firmware"),
