## artifacts/codex-runs/cisco-4h-lab-run-report.md

# Cisco 4h Lab Run Report


exec
/bin/bash -lc "{
  printf '# Cisco Console Port Access Report\\n\\n';
  printf -- '- Checked at: "'`%s`'"\\n' \""'$(date -u +%Y-%m-%dT%H:%M:%SZ)";
  printf -- '"'- User: "'`%s`'"\\n' \""'$(id -un)";
  printf -- '"'- Groups: "'`%s`'"\\n' \""'$(id -Gn)";
  printf -- '"'- Sudo required for this diagnostic: "'`no`'"\\n\\n';
  printf '## Enumerated Devices\\n\\n';
  found=0;
  for path in /dev/serial/by-id/* /dev/ttyUSB* /dev/ttyACM*; do
    [ -e \""'$path" ] || continue;
    found=1;
    printf '"'### "'`%s`'"\\n\\n' \""'$path";
    ls -l "$path" 2>/dev/null | sed '"'s/"'^/- ls: /'"';
    if [ -L \""'$path" ]; then printf -- '"'- realpath: "'`%s`'"\\n' \""'$(realpath "$path" 2>/dev/null || true)"; fi;
    if [ -r "$path" ]; then r=yes; else r=no; fi;
    if [ -w "$path" ]; then w=yes; else w=no; fi;
    printf -- '"'- readable_by_current_user: "'`%s`'"\\n' \""'$r";
    printf -- '"'- writable_by_current_user: "'`%s`'"\\n' \""'$w";
    if command -v lsof >/dev/null 2>&1; then
      out="$(lsof "$path" 2>&1 || true)";
      if [ -n "$out" ]; then printf -- '"'- lsof: "'`%s`'"\\n' \""'$(printf '"'%s' \""'$out" | tr '"'\\n' ' ' | sed 's/  */ /g')\"; else printf -- '- lsof: no owner reported\\n'; fi;
    else
      printf -- '- lsof: not installed\\n';
    fi;
    if command -v fuser >/dev/null 2>&1; then
      out=\""'$(fuser -v "$path" 2>&1 || true)";
      if [ -n "$out" ]; then printf -- '"'- fuser: "'`%s`'"\\n' \""'$(printf '"'%s' \""'$out" | tr '"'\\n' ' ' | sed 's/  */ /g')\"; else printf -- '- fuser: no owner reported\\n'; fi;
    else
      printf -- '- fuser: not installed\\n';
    fi;
    printf '\\n';
  done;
  if [ \""'$found" = 0 ]; then printf -- '"'- No /dev/serial/by-id, /dev/ttyUSB, or /dev/ttyACM devices found.\\n'; fi;
  printf '\\n## Access Notes\\n\\n';
  printf -- '- This diagnostic used current-user read/write checks only.\\n';
  printf -- '- If read/write is no, add the backend user to the device group such as dialout and restart the shell/session.\\n';
} > artifacts/codex-runs/cisco-console-port-access-report.md
