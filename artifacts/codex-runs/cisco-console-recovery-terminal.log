+def _looks_unreadable(prompt_text: str) -> bool:
+    if not prompt_text:
+        return False
+    replacement_count = prompt_text.count("\ufffd")
+    control_count = sum(1 for char in prompt_text if ord(char) < 32 and char not in "\r\n\t")
