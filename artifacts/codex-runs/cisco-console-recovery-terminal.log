+        "setup-wizard": "setup_wizard",
+        "rommon-bootloader": "rommon_or_bootloader",
+        "password-recovery-ready": "rommon_or_bootloader",
+        "port-in-use": "port_in_use",
+        "permission-denied": "permission_denied",
+    }.get(prompt_state, "no_bytes_read")
+
