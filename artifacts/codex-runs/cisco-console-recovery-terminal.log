+        and isinstance(prompt_sample, dict)
+        and not bool(prompt_sample.get("captured"))
+    ):
+        return "no_bytes_read"
+    return PROMPT_STATE_CLASSIFICATIONS.get(prompt_state, "no_bytes_read")
+
+
