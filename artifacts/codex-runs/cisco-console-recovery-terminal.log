    monkeypatch.setenv("FIRMWARE_WAIVER_EXPIRES", expires)
    monkeypatch.setenv("FIRMWARE_WAIVER_SCOPE", "all")
    record_probe_result("ilo-redfish", {"provider_id": "ilo-redfish", "status": "ok", "managers": [{"FirmwareVersion": "2.80"}]})

