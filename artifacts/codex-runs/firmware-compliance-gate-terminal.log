index 0000000000000000000000000000000000000000..f5175a8b37cdc88c768314cfff6db0a2748ecb33
--- /dev/null
+++ b/config/firmware-baselines/real-lab.yml
@@ -0,0 +1,66 @@
+baseline_id: real-lab
+description: Firmware and OS compliance baseline for the isolated real lab.
+components:
+  - id: hpe_ilo_firmware
+    device: iLO
+    label: HPE iLO firmware
+    minimum: "3.19"
+    approved: ["3.19"]
+    unknown_policy: blocked
