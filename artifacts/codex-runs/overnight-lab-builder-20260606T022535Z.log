+            const failure = objectValue(item);
+            return (
+              <SetupPreviewBlock
+                key={`failure-${index}`}
+                title={labelize(asString(failure.category) || "failure")}
+                tag={labelize(asString(failure.severity) || "blocked")}
+                lines={[asString(failure.next_action) || "Review certification failure."]}
