+def _run_live_stage(command: list[str], report: Path) -> dict[str, Any]:
+    env = _real_lab_env()
+    python = ".venv/bin/python" if (REPO_ROOT / "app" / "backend" / ".venv" / "bin" / "python").exists() else "python3"
+    result = subprocess.run(
