+from __future__ import annotations
+
+import json
+
+from app.services.full_rebuild_run import build_full_rebuild_summary_reports
+
+
+def main() -> int:
+    result = build_full_rebuild_summary_reports()
+    print(json.dumps(_summary(result), indent=2))
+    return 0
+
