+        <ProviderFact label="Mock Results" value={asBoolean(verification?.mock_results_used) ? "Used" : "Not used"} />
+        <ProviderFact label="Report" value={asString(artifacts.report) || "artifacts/codex-runs/build-verification-report.md"} />
