+                key={`check-${index}`}
+                title={asString(check.item) || "Checklist item"}
+                tag={labelize(asString(check.status) || "unknown")}
+                lines={["Product certification checklist item."]}
+              />
+            );
+          })}
+        </div>
+      )}
+    </section>
+  );
