     BASELINE_REPORT.write_text(_baseline_markdown(payload), encoding="utf-8")
     CISCO_BOOTSTRAP_REPORT.write_text(_stage_markdown("Cisco Full Bootstrap Report", payload, "cisco_bootstrap"), encoding="utf-8")
