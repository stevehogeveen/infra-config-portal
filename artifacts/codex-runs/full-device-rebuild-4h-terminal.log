+                key={key}
+                title={labelize(key)}
+                tag={labelize(asString(stage.status) || "unknown")}
+                lines={[
+                  asString(stage.message) || "No stage message recorded.",
+                  ...stringArray(stage.blockers).slice(0, 2)
+                ]}
+              />
+            );
+          })}
+        </div>
+      )}
+    </section>
+  );
+}
