    PLAN_REPORT.write_text(_plan_markdown(report), encoding="utf-8")
    print(json.dumps(_plan_summary(report), indent=2))
    print(f"plan_report={PLAN_REPORT.relative_to(REPO_ROOT)}")
    return 0 if preview.status != "blocked" else 1


