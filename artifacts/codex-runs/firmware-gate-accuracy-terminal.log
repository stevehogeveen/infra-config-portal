 def _command_summary(command: str, output: str) -> dict[str, Any]:
-    return {
+    summary: dict[str, Any] = {
         "command": command,
         "captured": bool(output),
         "output_bytes": len(output.encode("utf-8", errors="replace")),
         "raw_output_redacted": True,
