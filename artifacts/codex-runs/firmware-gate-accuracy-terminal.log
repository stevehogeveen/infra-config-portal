+    return component_id.startswith(prefixes)
+
+
+def _workflow_scope(scope: str) -> str:
+    lower = str(scope or "").lower()
+    if "netapp" in lower:
+        return "netapp"
+    if "cisco" in lower:
+        return "cisco"
+    if any(token in lower for token in ("hpe", "ilo", "raid", "esxi", "server")):
+        return "hpe"
+    return _normalize_scope(lower)
+
