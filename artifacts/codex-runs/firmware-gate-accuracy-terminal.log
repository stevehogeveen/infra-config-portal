+    patterns = (
+        r"Cisco IOS XE Software[^,\n]*,\s*Version\s+([^,\s]+)",
+        r"Cisco IOS Software[^,\n]*,\s*Version\s+([^,\s]+)",
+        r"\bVersion\s+(\d+(?:\.\d+)+)\b",
+    )
+    for pattern in patterns:
+        match = re.search(pattern, output, re.IGNORECASE)
+        if match:
