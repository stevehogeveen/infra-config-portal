+def _bootloader_rommon_version(output: str) -> str | None:
+    match = re.search(r"(?:ROMMON|BOOTLDR|BOOT LOADER)[^0-9]*(\d+(?:\.\d+)+)", output, re.IGNORECASE)
+    return match.group(1) if match else None
