+          `SSH: ${presenceLabel(realLabRun.ssh_status)}; SCP: ${labelize(asString(realLabRun.scp_status) || "not-attempted")}.`,
+          `Last blocker: ${asString(realLabRun.last_blocker) || "None"}.`
+        ]}
