import base64, json, time, urllib.request

base = 'http://127.0.0.1:4444'

def req(method, path, payload=None):
    data = None if payload is None else json.dumps(payload).encode()
    r = urllib.request.Request(base + path, data=data, method=method, headers={'Content-Type': 'application/json'})
    with urllib.request.urlopen(r, timeout=20) as resp:
        return json.loads(resp.read().decode())

session = req('POST', '/session', {
    'capabilities': {
        'alwaysMatch': {
            'browserName': 'firefox',
            'moz:firefoxOptions': {'args': ['-headless']}
        }
    }
})['value']['sessionId']
try:
    req('POST', f'/session/{session}/window/rect', {'width': 1440, 'height': 1200})
    req('POST', f'/session/{session}/url', {'url': 'http://127.0.0.1:5174/providers'})
    deadline = time.time() + 30
    body = ''
    while time.time() < deadline:
        body = req('POST', f'/session/{session}/execute/sync', {
            'script': 'return document.body ? document.body.innerText : \"\";',
            'args': []
        })['value'] or ''
        if 'Cisco Real-Lab Run' in body and 'Privileged exec prompt is required for bootstrap apply.' in body:
            break
        time.sleep(0.5)
    if 'Cisco Real-Lab Run' not in body:
        raise SystemExit('Cisco Real-Lab Run text not found')
    png_b64 = req('GET', f'/session/{session}/screenshot')['value']
    with open('artifacts/screenshots/cisco-real-lab-readiness.png', 'wb') as fh:
        fh.write(base64.b64decode(png_b64))
    print('screenshot saved')
finally:
    req('DELETE', f'/session/{session}')
PY" in /home/administrator/infra-config-portal
