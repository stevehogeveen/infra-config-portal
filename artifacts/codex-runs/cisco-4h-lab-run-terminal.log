diff --git a/app/backend/app/services/cisco_setup_readiness.py b/app/backend/app/services/cisco_setup_readiness.py
index 7fcd767738882b9ea1e779a81be703e3d17ac08f..d704b46f341999ea5833164f33f90c784d79bdc0
--- a/app/backend/app/services/cisco_setup_readiness.py
+++ b/app/backend/app/services/cisco_setup_readiness.py
@@ -1,14 +1,17 @@
 from __future__ import annotations
 
+import json
 from typing import Any
 
 from app.core.config import settings
 from app.providers.base import ProviderStatus
