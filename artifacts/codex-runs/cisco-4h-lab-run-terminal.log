+            "prompt_state": "unknown-no-output"
+            if not any(sample.get("captured") for sample in samples)
+            else "unknown",
+            "prompt_detected": False,
+            "bauds_tried": list(BAUD_RATES),
+            "wake_sequences_tried": [item["name"] for item in WAKE_SEQUENCES],
+        },
